---
source: shorwatch-rules/tests/inventory.rs
expression: inventory
---
3DES:
  - "Call { receiver: \"javax.crypto.Cipher\", method: \"getInstance\", arg: Some(ArgPattern { index: 0, matches: \"(?i)^(DESede|TripleDES|3DES)(/|$)\" }), origin: None }"
  - "Call { receiver: \"javax.crypto.KeyGenerator\", method: \"getInstance\", arg: Some(ArgPattern { index: 0, matches: \"(?i)^(DESede|TripleDES|3DES)$\" }), origin: None }"
  - "Call { receiver: \"javax.crypto.SecretKeyFactory\", method: \"getInstance\", arg: Some(ArgPattern { index: 0, matches: \"(?i)^(DESede|TripleDES|3DES)$\" }), origin: None }"
  - "Construct { ty: \"javax.crypto.spec.DESedeKeySpec\", arg: None }"
  - "Construct { ty: \"javax.crypto.spec.SecretKeySpec\", arg: Some(ArgPattern { index: 1, matches: \"(?i)^(DESede|TripleDES|3DES)$\" }) }"
  - "Construct { ty: \"org.bouncycastle.crypto.engines.DESedeEngine\", arg: None }"
  - "Construct { ty: \"org.bouncycastle.crypto.engines.DESedeWrapEngine\", arg: None }"
  - "Field { owner: \"okhttp3.CipherSuite\", matches: Some(\"3DES_EDE\") }"
  - "Field { owner: \"org.apache.xml.security.encryption.XMLCipher\", matches: Some(\"^TRIPLEDES\") }"
  - "Field { owner: \"org.bouncycastle.bcpg.SymmetricKeyAlgorithmTags\", matches: Some(\"^TRIPLE_DES$\") }"
  - "Field { owner: \"org.bouncycastle.openpgp.PGPEncryptedData\", matches: Some(\"^TRIPLE_DES$\") }"
  - "Field { owner: \"org.opensaml.xml.encryption.EncryptionConstants\", matches: Some(\"^ALGO_ID_(BLOCKCIPHER|KEYWRAP)_TRIPLEDES\") }"
  - "Field { owner: \"org.opensaml.xmlsec.encryption.support.EncryptionConstants\", matches: Some(\"^ALGO_ID_(BLOCKCIPHER|KEYWRAP)_TRIPLEDES\") }"
  - "Literal { matches: \"(^|[,:\\\\s])(TLS|SSL)_\\\\w*3DES_EDE\", unless_call: Some(\"(?i)(exclude|disable|remove|deny|block|reject)\") }"
  - "Property { key: \"(?i)(^|\\\\.)(ssl|options)\\\\.(ciphers|cipher-?suites|enabled-?cipher-?suites)(\\\\[\\\\d+\\\\])?$\", matches: Some(\"(?i)3DES_EDE\") }"
AES-128:
  - "Call { receiver: \"com.google.crypto.tink.KeyTemplates\", method: \"get\", arg: Some(ArgPattern { index: 0, matches: \"^AES128_\" }), origin: None }"
  - "Call { receiver: \"javax.crypto.Cipher\", method: \"getInstance\", arg: Some(ArgPattern { index: 0, matches: \"(?i)^AES_128(/|$)\" }), origin: None }"
  - "Call { receiver: \"javax.crypto.KeyGenerator\", method: \"init\", arg: Some(ArgPattern { index: 0, matches: \"^128$\" }), origin: Some(ArgPattern { index: 0, matches: \"(?i)^AES\" }) }"
  - "Field { owner: \"com.amazonaws.services.kms.model.DataKeySpec\", matches: Some(\"^AES_128$\") }"
  - "Field { owner: \"com.azure.security.keyvault.keys.cryptography.models.EncryptionAlgorithm\", matches: Some(\"^A128\") }"
  - "Field { owner: \"com.azure.security.keyvault.keys.cryptography.models.KeyWrapAlgorithm\", matches: Some(\"^A128\") }"
  - "Field { owner: \"com.google.crypto.tink.aead.AeadKeyTemplates\", matches: Some(\"^AES128_\") }"
  - "Field { owner: \"com.google.crypto.tink.aead.PredefinedAeadParameters\", matches: Some(\"^AES128_\") }"
  - "Field { owner: \"okhttp3.CipherSuite\", matches: Some(\"AES_128_\") }"
  - "Field { owner: \"org.apache.xml.security.encryption.XMLCipher\", matches: Some(\"^AES_128\") }"
  - "Field { owner: \"org.bouncycastle.bcpg.SymmetricKeyAlgorithmTags\", matches: Some(\"^AES_128$\") }"
  - "Field { owner: \"org.bouncycastle.openpgp.PGPEncryptedData\", matches: Some(\"^AES_128$\") }"
  - "Field { owner: \"org.opensaml.xml.encryption.EncryptionConstants\", matches: Some(\"^ALGO_ID_(BLOCKCIPHER|KEYWRAP)_AES128\") }"
  - "Field { owner: \"org.opensaml.xmlsec.encryption.support.EncryptionConstants\", matches: Some(\"^ALGO_ID_(BLOCKCIPHER|KEYWRAP)_AES128\") }"
  - "Field { owner: \"software.amazon.awssdk.services.kms.model.DataKeySpec\", matches: Some(\"^AES_128$\") }"
  - "Literal { matches: \"(^|[,:\\\\s])(TLS_\\\\w*AES_128_|([A-Z0-9]+-)*AES128-(GCM-SHA256|SHA(256)?|CCM8?)($|[,:\\\\s]))\", unless_call: Some(\"(?i)(exclude|disable|remove|deny|block|reject)\") }"
  - "Property { key: \"(?i)(^|\\\\.)(ssl|options)\\\\.(ciphers|cipher-?suites|cipher\\\\.suites|enabled-?cipher-?suites)(\\\\[\\\\d+\\\\])?$\", matches: Some(\"(?i)(^|[,:\\\\s])(TLS_\\\\w*AES_128_|([A-Z0-9]+-)*AES128-(GCM-SHA256|SHA(256)?|CCM8?)($|[,:\\\\s]))\") }"
AES-128 (JOSE/JWE):
  - "Call { receiver: \"com.nimbusds.jose.EncryptionMethod\", method: \"parse\", arg: Some(ArgPattern { index: 0, matches: \"^A128(GCM|CBC-HS256)$\" }), origin: None }"
  - "Call { receiver: \"com.nimbusds.jose.JWEAlgorithm\", method: \"parse\", arg: Some(ArgPattern { index: 0, matches: \"(^|\\\\+)A128(GCM)?KW$\" }), origin: None }"
  - "Field { owner: \"com.nimbusds.jose.EncryptionMethod\", matches: Some(\"^A128(GCM|CBC_HS256)$\") }"
  - "Field { owner: \"com.nimbusds.jose.JWEAlgorithm\", matches: Some(\"(^|_)A128(GCM)?KW$\") }"
  - "Field { owner: \"io.jsonwebtoken.Jwts.ENC\", matches: Some(\"^A128(GCM|CBC_HS256)$\") }"
  - "Field { owner: \"io.jsonwebtoken.Jwts.KEY\", matches: Some(\"(^|_)A128(GCM)?KW$\") }"
  - "Property { key: \"(?i)(^|\\\\.)(alg|algorithms?|enc)(\\\\[\\\\d+\\\\])?$\", matches: Some(\"^(A128(GCM|CBC-HS256|KW|GCMKW)|(ECDH-ES|ECDH-1PU|PBES2-HS256)\\\\+A128KW)$\") }"
DSA:
  - "Call { receiver: \"com.jcraft.jsch.JSch\", method: \"setConfig\", arg: Some(ArgPattern { index: 1, matches: \"(^|,)ssh-dss(,|$)\" }), origin: None }"
  - "Call { receiver: \"com.jcraft.jsch.Session\", method: \"setConfig\", arg: Some(ArgPattern { index: 1, matches: \"(^|,)ssh-dss(,|$)\" }), origin: None }"
