  - "Construct { ty: \"java.security.spec.DSAParameterSpec\", arg: None }"
  - "Construct { ty: \"java.security.spec.DSAPrivateKeySpec\", arg: None }"
  - "Construct { ty: \"java.security.spec.DSAPublicKeySpec\", arg: None }"
  - "Construct { ty: \"org.bouncycastle.crypto.generators.DSAKeyPairGenerator\", arg: None }"
  - "Construct { ty: \"org.bouncycastle.crypto.generators.DSAParametersGenerator\", arg: None }"
  - "Construct { ty: \"org.bouncycastle.crypto.signers.DSASigner\", arg: None }"
  - "Construct { ty: \"org.bouncycastle.operator.bc.BcDSAContentSignerBuilder\", arg: None }"
  - "Construct { ty: \"org.bouncycastle.operator.jcajce.JcaContentSignerBuilder\", arg: Some(ArgPattern { index: 0, matches: \"(?i)^.+withDSA$\" }) }"
  - "Field { owner: \"com.jcraft.jsch.KeyPair\", matches: Some(\"^DSA$\") }"
  - "Field { owner: \"javax.xml.crypto.dsig.SignatureMethod\", matches: Some(\"^DSA_\") }"
  - "Field { owner: \"org.apache.sshd.common.config.keys.KeyUtils\", matches: Some(\"^DSS_ALGORITHM$\") }"
  - "Field { owner: \"org.apache.sshd.common.signature.BuiltinSignatures\", matches: Some(\"^dsa\") }"
  - "Field { owner: \"org.apache.xml.security.signature.XMLSignature\", matches: Some(\"^ALGO_ID_SIGNATURE_DSA\") }"
  - "Field { owner: \"org.bouncycastle.bcpg.PublicKeyAlgorithmTags\", matches: Some(\"^DSA$\") }"
  - "Field { owner: \"org.bouncycastle.openpgp.PGPPublicKey\", matches: Some(\"^DSA$\") }"
  - "Field { owner: \"org.opensaml.xml.signature.SignatureConstants\", matches: Some(\"^ALGO_ID_SIGNATURE_DSA\") }"
  - "Field { owner: \"org.opensaml.xmlsec.signature.support.SignatureConstants\", matches: Some(\"^ALGO_ID_SIGNATURE_DSA\") }"
  - "Key { algorithm: Some(\"^DSA$\"), signature: None }"
