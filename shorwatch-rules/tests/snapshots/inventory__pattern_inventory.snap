  - "Call { receiver: \"javax.crypto.KeyGenerator\", method: \"getInstance\", arg: Some(ArgPattern { index: 0, matches: \"(?i)^(DESede|TripleDES|3DES|TDEA)(Wrap)?$\" }), with_arg: None, origin: None, unless_chain: None }"
  - "Call { receiver: \"javax.crypto.SecretKeyFactory\", method: \"getInstance\", arg: Some(ArgPattern { index: 0, matches: \"(?i)^((DESede|TripleDES|3DES|TDEA)|PBEWith\\\\w+And(\\\\d-?Key)?(TripleDES|DESede)(-CBC)?|(OID\\\\.)?(1\\\\.2\\\\.840\\\\.113549\\\\.1\\\\.12\\\\.1\\\\.[34]|1\\\\.2\\\\.840\\\\.113549\\\\.3\\\\.7))$\" }), with_arg: None, origin: None, unless_chain: None }"
