---
source: shorwatch-rules/tests/inventory.rs
expression: inventory
---
3DES:
  - "Call { receiver: \"javax.crypto.Cipher\", method: \"getInstance\", arg: Some(ArgPattern { index: 0, matches: \"(?i)^(DESede|TripleDES|3DES)(/|$)\" }), origin: None }"
  - "Call { receiver: \"javax.crypto.KeyGenerator\", method: \"getInstance\", arg: Some(ArgPattern { index: 0, matches: \"(?i)^(DESede|TripleDES|3DES)$\" }), origin: None }"
  - "Call { receiver: \"javax.crypto.SecretKeyFactory\", method: \"getInstance\", arg: Some(ArgPattern { index: 0, matches: \"(?i)^(DESede|TripleDES|3DES)$\" }), origin: None }"
  - "Construct { ty: \"javax.crypto.spec.DESedeKeySpec\", arg: None }"
  - "Construct { ty: \"javax.crypto.spec.SecretKeySpec\", arg: Some(ArgPattern { index: 1, matches: \"(?i)^(DESede|TripleDES|3DES)$\" }) }"
  - "Construct { ty: \"org.bouncycastle.crypto.engines.DESedeEngine\", arg: None }"
  - "Construct { ty: \"org.bouncycastle.crypto.engines.DESedeWrapEngine\", arg: None }"
  - "Field { owner: \"org.apache.xml.security.encryption.XMLCipher\", matches: Some(\"^TRIPLEDES\") }"
  - "Property { key: \"(?i)(^|\\\\.)(ssl|options)\\\\.(ciphers|cipher-?suites|enabled-?cipher-?suites)(\\\\[\\\\d+\\\\])?$\", matches: Some(\"(?i)3DES_EDE\") }"
AES-128:
  - "Call { receiver: \"javax.crypto.Cipher\", method: \"getInstance\", arg: Some(ArgPattern { index: 0, matches: \"(?i)^AES_128(/|$)\" }), origin: None }"
  - "Call { receiver: \"javax.crypto.KeyGenerator\", method: \"init\", arg: Some(ArgPattern { index: 0, matches: \"^128$\" }), origin: Some(ArgPattern { index: 0, matches: \"(?i)^AES\" }) }"
  - "Field { owner: \"org.apache.xml.security.encryption.XMLCipher\", matches: Some(\"^AES_128\") }"
  - "Property { key: \"(?i)(^|\\\\.)(ssl|options)\\\\.(ciphers|cipher-?suites|enabled-?cipher-?suites)(\\\\[\\\\d+\\\\])?$\", matches: Some(\"(?i)(^|[,\\\\s])TLS_\\\\w*AES_128_\") }"
