  - "Call { receiver: \"System.Security.Cryptography.SymmetricAlgorithm\", method: \"Create\", arg: Some(ArgPattern { index: 0, matches: \"(?i)^(3DES|Triple ?DES|System\\\\.Security\\\\.Cryptography\\\\.TripleDES(CryptoServiceProvider|Cng)?)$\" }), with_arg: None, origin: None, unless_chain: None }"
